{
  "name": "wikipedia-kaios",
  "version": "1.9.0",
  "description": "Wikipedia KaiOS app",
  "private": true,
  "scripts": {
    "res:build": "rescript build",
    "res:watch": "rescript watch",
    "build": "rescript build && vite build",
    "build:ci": "rescript build && cross-env DISABLE_REQUEST_HEADER=1 vite build",
    "dev": "rescript build && cross-env DISABLE_REQUEST_HEADER=1 INSTRUMENTATION=1 RAND=1 vite",
    "start": "http-server -p 8080 dist",
    "preview": "vite preview --port 8080",
    "test": "rescript build && vitest run",
    "test:watch": "rescript build && vitest",
    "test:e2e": "playwright test",
    "lint:styles": "stylelint \"style/**/*.scss\"",
    "stats": "cloc src --exclude-dir=node_modules --not-match-f=[.]res[.]mjs",
    "banana": "banana-checker i18n/",
    "adb:connect": "adb forward tcp:6000 localfilesystem:/data/local/debugger-socket",
    "b2g:uninstall": "node ./node_modules/b2g-cli-tool/b2g.js uninstall Wikipedia",
    "b2g:install": "node ./node_modules/b2g-cli-tool/b2g.js install dist",
    "deploy": "cross-env INSTRUMENTATION=1 RAND=1 npm run build && npm run adb:connect && ( npm run b2g:uninstall || echo ) && npm run b2g:install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wikimedia/wikipedia-kaios.git"
  },
  "keywords": [
    "wikipedia",
    "kaios"
  ],
  "author": "Wikimedia Foundation",
  "license": "MIT",
  "bugs": {
    "url": "https://phabricator.wikimedia.org/project/profile/4305/"
  },
  "homepage": "https://github.com/wikimedia/wikipedia-kaios#readme",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@rescript/react": "^0.15.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "b2g-cli-tool": "github:fabricedesre/b2gclitool",
    "browserslist": "^4.29.3",
    "core-js": "^3.50.0",
    "cross-env": "^7.0.3",
    "eslint": "^7.32.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-config-standard-preact": "^1.1.6",
    "eslint-plugin-import": "^2.24.0",
    "eslint-plugin-no-only-tests": "^2.6.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-react": "^7.25.1",
    "eslint-plugin-standard": "^4.0.1",
    "fake-indexeddb": "^6.2.6",
    "grunt-banana-checker": "^0.9.0",
    "http-server": "^13.0.1",
    "intl-pluralrules": "^1.3.0",
    "jsdom": "^30.1.3",
    "lodash": "^4.17.21",
    "minimatch": "^3.0.4",
    "postcss-scss": "^4.0.9",
    "rescript": "^12.3.1",
    "sass": "^1.105.2",
    "stylelint": "^13.13.0",
    "stylelint-config-wikimedia": "^0.11.1",
    "terser": "^5.51.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "banana-i18n": "2.0.0",
    "history": "^4.10.1",
    "preact": "^10",
    "preact-router": "^3.2.1",
    "react": "^19",
    "react-dom": "^19"
  }
}
